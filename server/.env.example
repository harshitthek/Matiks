# Matiks Backend Server Environment Configuration

# Server Port (default: 3001)
PORT=3001

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=development

# Admin Authorization Secret
# REQUIRED in production. Must not be empty or use the dev default in production.
ADMIN_SECRET=hackathon_admin_secret

# Authentication Mode: 'local' (self-contained hackathon login) | 'club_oidc' (central fossclub.tech OIDC)
AUTH_MODE=local

# USAR FOSS Club OIDC Settings (required when AUTH_MODE=club_oidc)
CLUB_OIDC_ISSUER_URL=https://www.fossclub.tech
CLUB_OIDC_CLIENT_ID=matiks_hackathon
CLUB_OIDC_CLIENT_SECRET=matiks_oidc_dev_secret
CLUB_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback

# Allowed CORS Origins (comma-separated list of origins permitted to access REST & SSE APIs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://matiks.fossclub.tech,https://fossclub.tech,https://www.fossclub.tech
